{{!< default}}

{{!-- The tag above means: insert everything in this file
into the {body} tag of the default.hbs template --}}

<main id="site-main" class="site-main">
<style>
  hr.post-divider {
    border-color: #1e9ae0;
  }

  .post-index {
    margin: 2rem 0 3rem;
    padding: 1.5rem;
    border: 1px solid #e5e8eb;
    border-radius: 8px;
    background: #f8fafc;
    font-size: 0.8rem;
    line-height: 1;
  }

  .post-index h3 {
    margin-top: 0;
  }

  .post-index ul {
    list-style: none;
    padding-left: 0;
    margin: 0 !important;
  }

  .post-index li {
    margin-top: 0;
    line-height: 1.3em;
  }

  .post-index a {
    text-decoration: none;
    color: inherit;
    display: inline-block;
    max-width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .post-index a:hover {
    text-decoration: underline;
  }

  @media (min-width: 1100px) {
    .post-index {
      float: right;
      width: 28%;
      margin: 0 0 3rem 2rem;
      position: sticky;
      top: 2rem;
      z-index: 2;
    }

    .posts-with-index {
      margin-right: 32%;
    }
  }
</style>
<article class="article {{post_class}}">
    {{#page}}
    {{#match @page.show_title_and_feature_image}}
        <header class="article-header gh-canvas">

            <h1 class="article-title">{{title}}</h1>

            {{#if feature_image}}
                <figure class="article-image">
                    {{!-- This is a responsive image, it loads different sizes depending on device
                    https://medium.freecodecamp.org/a-guide-to-responsive-images-with-ready-to-use-templates-c400bd65c433 --}}
                    <img
                        srcset="{{img_url feature_image size="s"}} 300w,
                                {{img_url feature_image size="m"}} 600w,
                                {{img_url feature_image size="l"}} 1000w,
                                {{img_url feature_image size="xl"}} 2000w"
                        sizes="(min-width: 1400px) 1400px, 92vw"
                        src="{{img_url feature_image size="xl"}}"
                        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                    />
                    {{#if feature_image_caption}}
                        <figcaption>{{feature_image_caption}}</figcaption>
                    {{/if}}
                </figure>
            {{/if}}

        </header>
    {{/match}}

    <section class="gh-content gh-canvas">
        {{content}}
    </section>
    {{/page}}

    <section class="gh-content gh-canvas post-index">
      <ul>
        {{#foreach posts}}
          <li><a href="#post-{{slug}}">{{title}}</a></li>
        {{/foreach}}
      </ul>
    </section>

    <section class="gh-content gh-canvas posts-with-index">
    {{#foreach posts}}
      <article class="post-full" id="post-{{slug}}">
        <header class="post-full-header">
          <h2 class="post-full-title">
            <a href="#post-{{slug}}">{{title}}</a>
          </h2>
            <i>{{date format="dddd, DD. MMM YYYY"}}</i>
            {{#if feature_image}}
                <figure class="article-image">
                    {{!-- This is a responsive image, it loads different sizes depending on device
                    https://medium.freecodecamp.org/a-guide-to-responsive-images-with-ready-to-use-templates-c400bd65c433 --}}
                    <img
                        srcset="{{img_url feature_image size="s"}} 300w,
                                {{img_url feature_image size="m"}} 600w,
                                {{img_url feature_image size="l"}} 1000w,
                                {{img_url feature_image size="xl"}} 2000w"
                        sizes="(min-width: 1400px) 1400px, 92vw"
                        src="{{img_url feature_image size="xl"}}"
                        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                    />
                    {{#if feature_image_caption}}
                        <figcaption>{{feature_image_caption}}</figcaption>
                    {{/if}}
                </figure>
            {{/if}}
          {{!-- <div class="post-meta">
            <time class="post-full-date" datetime="{{date format="YYYY-MM-DD"}}">
              {{date format="DD MMM YYYY"}}
            </time>
          </div> --}}
        </header>

        <section class="post-full-content">
        {{!-- <section class="gh-content gh-canvas"> --}}
          {{content}}
        </section>
      </article>

      {{#unless @last}}
        <hr class="post-divider">
      {{/unless}}
    {{/foreach}}
    </section>


</article>
</main>
